# Zerodha AI Financial Intelligence Platform - Environment Variables Template

# 1. Google Gemini AI API Configuration
# Get your free key at: https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key_here

# 2. Relational Database Configuration
# NeonDB Serverless PostgreSQL connection URI (falls back to local SQLite if empty)
# Example: postgresql://username:password@ep-cool-cloud.ap-southeast-1.aws.neon.tech/neondb?sslmode=require
NEON_DATABASE_URL=your_neondb_postgresql_url_here

# 3. Security & JWT Configuration
JWT_SECRET_KEY=zerodha-ai-super-secret-key-2026-production

# 4. Optional Market Feeds (Fallback to free yfinance if unset)
ALPHA_VANTAGE_API_KEY=
KITE_CONNECT_API_KEY=

# 5. MCP Server Configuration
MCP_SERVER_PORT=5000
MCP_PROTOCOL_VERSION=2025-06-18
